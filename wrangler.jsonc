{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "linear-claude-webhook-bridge",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"workers_dev": true,
	"vars": {
		// Linear user names allowed to trigger the routine with a comment, label or assignment/delegation. A leading "@" is optional.
		"ALLOWED_ACTORS": ["David"],
		// Per route (/webhook/<name>), what fires its routine:
		//   COMMENT_KEYWORDS: a new comment/description (or an edit) adds one of these keywords
		//   LABELS: an issue gets one of these labels
		//   ASSIGNEES: an issue is assigned or delegated to one of these names
		"ROUTE_FILTERS": {
			"boticorn": { "COMMENT_KEYWORDS": ["@boticorn"], "ASSIGNEES": ["Boticorn"], "LABELS": ["boticorn", "boticorn-investigate"] }
		},
		// Events sent by these user/app names are dropped so the bot can't trigger itself.
		"IGNORED_SENDERS": ["Boticorn"]
	},
	// Secrets (set with `wrangler secret put`):
	//   LINEAR_WEBHOOK_SECRET (or CLOUDFLARE_WEBHOOK_SIGNING_SECRET),
	//   LINEAR_APP_TOKEN,
	//   ROUTINES (JSON route name -> {url, token}, see README)
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
